@model RepositorioTutorias.Models.Documento
@{ ViewData["Title"] = "Editar documento"; }
<h2>Editar documento</h2>
<p class="text-muted">Archivo actual: @Model.NombreArchivo (no se puede cambiar)</p>
<form asp-action="Editar" method="post">
    <input type="hidden" asp-for="IdDocumento" />
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary">Guardar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>