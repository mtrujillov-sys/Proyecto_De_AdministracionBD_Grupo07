@model RepositorioTutorias.Models.Usuario
<form method="post">
    <input type="hidden" asp-for="IdUsuario" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Nombres" class="form-label">Nombres</label>
        <input asp-for="Nombres" class="form-control" />
        <span asp-validation-for="Nombres" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Correo" class="form-label">Correo</label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdRol" class="form-label">Rol</label>
        <select asp-for="IdRol" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Roles)">
            <option value="">-- Elija un rol --</option>
        </select>
        <span asp-validation-for="IdRol" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdCarrera" class="form-label">Carrera</label>
        <select asp-for="IdCarrera" class="form-select" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Carreras)">
            <option value="">-- Sin carrera (solo administrador general) --</option>
        </select>
        <span asp-validation-for="IdCarrera" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>
